{
  "manifest_version": 3,
  "name": "ELO DevTools - Tools for developers",
  "short_name": "ELO DevTools",
  "description": "ELO DevTools is a collection of tools for developers.",
  "version": "1.0.0",
  "icons": {
    "16": "assets/logos/favicon.ico",
    "48": "assets/logos/icon-192.png",
    "128": "assets/logos/icon-512.png",
    "192": "assets/logos/icon-192.png",
    "512": "assets/logos/icon-512.png"
  },
  "offline_enabled": true,
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open sidebar"
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ]
}