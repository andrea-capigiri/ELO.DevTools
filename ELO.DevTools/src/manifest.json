{
  "manifest_version": 3,
  "name": "ELO.DevTools",
  "version": "1.0.0",
  "icons": {
    "16": "./assets/images/icon-192.png",
    "48": "./assets/images/icon-192.png",
    "128": "./assets/images/icon-512.png",
    "192": "./assets/images/icon-192.png",
    "512": "./assets/images/icon-512.png"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open sidebar"
  },
  "background": {
    "service_worker": "/assets/background.js"
  },
  "offline_enabled": true,
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ]
}