{
  "manifest_version": 3,
  "name": "My Sidebar Extension",
  "version": "1.0",
  "permissions": [
    "sidePanel",
    "favicon",
    "bookmarks"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open sidebar"
  },
  "background": {
    "service_worker": "/assets/background.js"
  },
  "offline_enabled": true,
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ]
}